<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChessNLPCoachApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChessNLPCoachApp.styles.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"] ?? "bg-default")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand py-0" asp-area="" asp-controller="Analysis" asp-action="Index">
                    <img src="~/images/chesslogo.jpg" alt="ChessNLPCoachApp" class="navbar-logo" />
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="ms-auto me-3">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            Logout
                        </button>

                    </form>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white box-shadow">
        <div class="container-fluid px-4">
            &copy; @DateTime.Now.Year - ChessNLPCoachApp
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
